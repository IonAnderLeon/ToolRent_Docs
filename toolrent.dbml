  price float
}
*/




Table rentals {
  id uuid [primary key]
  client_id uuid [ref: > clients.id, not null]
  vendor_id uuid [ref: > vendors.id, not null]
  start_date timestamp [not null]
  end_date timestamp [not null]
  status varchar // 'pending', 'active', 'finished', 'cancelled'
  total_amount float
  deposit_amount float
}

Table rental_items {
  id uuid [primary key]
  rental_id uuid [ref: > rentals.id, not null]
  inventory_id uuid [ref: > inventory.id, not null]
  price_per_day float [not null]
}



Table payments {
  id uuid [primary key]
  rental_id uuid [ref: > rentals.id, not null]
  amount float
  type varchar // 'rental', 'deposit', 'refund'
  status varchar // 'pending', 'completed', 'failed'
  transaction_id varchar
}

Table invoices {
  id uuid [primary key]
  client_id uuid [ref: > clients.id, not null]
  rental_id uuid [ref: > rentals.id]
  pdf_url varchar
  total float
  issued_at timestamp
}

Table rental_photos {
  id uuid [primary key]
  rental_id uuid [ref: > rentals.id, not null]
  type varchar // 'delivery', 'return'
  photo_url varchar
  created_at timestamp
}





