// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs


Table users {
  id uuid [primary key]
  username varchar
  role varchar
  password varchar
  email varchar
  
}

Table clients {
  id uuid [primary key]
  users_id uuid [ref: > users.id, not null]
  nif varchar
  phone varchar
  address varchar
  latitude varchar
  longitud varchar
  
}

Table vendors {
  id uuid [primary key]
  user_id uuid [ref: - users.id, not null]
  nif varchar
  business_name varchar
  phone varchar
  latitude varchar
  longitude varchar
  address varchar
  is_active bool
  
}

Table tools {
  id uuid [primary key]
  name varchar
  description varchar
  photo_url varchar
  category_id uuid [ref: > categories.id, not null]
}

Table categories {
  id uuid [primary key]
  name string
  
}

Table inventory {
  id uuid [primary key]
  stock int
  price float
  tool_id uuid [ref: > tools.id, not null]
  vendor_id uuid [ref: > vendors.id, not null]
}
